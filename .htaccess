Options -Indexes
RewriteEngine On

RewriteRule ^(?:app|vendor)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{THE_REQUEST} \s/+public(?:/|\s|\?)
RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]
RewriteRule ^public(?:/|$) - [L]

RewriteRule ^$ public/index.php [L]
RewriteRule ^(.+)$ public/$1 [L]
